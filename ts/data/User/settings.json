{
  "breadcrumbs.enabled": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.formatOnSave": true,
  // hide imports
  // "editor.foldingImportsByDefault": true,
  // "editor.foldingStrategy": "auto",
  // "editor.defaultFoldingRangeProvider": null,
  // Typography
  // https://github.com/tonsky/FiraCode
  // https://github.com/tonsky/FiraCode/wiki/VS-Code-Instructions
  "editor.fontFamily": "'Fira Code Retina', 'Dank Mono'",
  // "editor.fontSize": 18,
  "editor.fontLigatures": true,
  "editor.fontWeight": "450", // Retina !! Only works with FiraCode-VF.ttf installed, see below when using separated font files (the normal case).
  "editor.inlineSuggest.enabled": true,
  "editor.lineHeight": 1.6,
  "editor.minimap.enabled": false,
  "editor.tokenColorCustomizations": {
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#000"
          }
        }
      ]
    },
    "[*Dark*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    },
    "textMateRules": []
  },
  "editor.renderWhitespace": "all",
  // "editor.rulers": [
  //   120
  // ],
  "editor.smoothScrolling": true,
  "editor.suggestSelection": "first",
  "editor.wordWrap": "on",
  "extensions.autoUpdate": true,
  // "explorer.compactFolders": false,
  // "explorer.excludeGitIgnore": false,
  // "explorer.openEditors.visible": 1,
  "explorer.fileNesting.enabled": true,
  "files.associations": {
    ".env*": "dotenv"
  },
  // "files.autoSave": "afterDelay",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "focus.opacity": "0.7",
  "focus.highlightRange": "block",
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": true,
  "search.useGlobalIgnoreFiles": true,
  "search.useIgnoreFiles": true,
  "terminal.explorerKind": "external",
  "terminal.external.windowsExec": "",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  // "terminal.integrated.detectLocale": "off",
  "terminal.integrated.env.osx": {},
  "terminal.integrated.fontFamily": "'Fira Code Retina', 'Dank Mono'",
  "terminal.integrated.profiles.windows": {
    "Git Bash": {
      "source": "Git Bash",
      "icon": "terminal-bash",
      "path": ["C:\\Program Files\\Git\\bin\\bash.exe"],
      "args": ["--login"]
    },
    "Windows Terminal": {
      "path": "C:\\Users\\Devlegacy\\AppData\\Local\\Microsoft\\WindowsApps\\wt.exe"
    },
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
      // "args": ["-NoProfile"]
    },
    // "PowerShell": null,
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    }
  },
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "/bin/zsh",
      "args": ["--login"]
    }
  },
  "terminal.integrated.tabs.enabled": false,
  "workbench.colorTheme": "Night Owl (No Italics)",
  "workbench.colorCustomizations": {
    "editorBracketHighlight.foreground1": "#58cdff",
    "editorBracketHighlight.foreground2": "#ff9ce3",
    "editorBracketHighlight.foreground3": "#9161ff",
    "editorBracketHighlight.foreground4": "#e7b454",
    "editorBracketHighlight.foreground5": "#49c54f"
  },
  "workbench.editor.labelFormat": "short",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.list.smoothScrolling": true,
  "workbench.list.horizontalScrolling": true,
  "workbench.tree.indent": 20,
  "workbench.settings.editor": "json",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "welcomePage",
  // "window.autoDetectColorScheme": true,
  // "window.title": "🚀",
  "window.titleBarStyle": "custom",
  // set default to prettier and config eslint just in project
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  // set default to prettier and config eslint just in project
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // "[typescript]": {
  //   "editor.codeActionsOnSave": {
  //     "source.fixAll.eslint": "explicit"
  //   },
  //   "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  // },
  "bashIde.explainshellEndpoint": "http://localhost:5000",
  "cSpell.language": "en,es",
  "dotenv.enableAutocloaking": false,
  // "eslint.validate": ["typescript"],
  // "eslint.format.enable": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "yaml": true
  },
  "hediet.vscode-drawio.resizeImages": null,
  "i18n-ally.translate.deepl.apiKey": "a45391ad-c867-3778-49af-93ff4b70caba",
  // "javascript.inlayHints.parameterNames.enabled": "all",
  // "javascript.inlayHints.variableTypes.enabled": true,
  // "javascript.inlayHints.propertyDeclarationTypes.enabled": true,
  // "javascript.inlayHints.parameterTypes.enabled": true,
  // "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
  // https://github.com/microsoft/vscode/pull/174286
  // https://github.com/PKief/vscode-material-icon-theme/issues/1892
  // https://github.com/PKief/vscode-material-icon-theme/issues/330
  "material-icon-theme.folders.associations": {
    "infrastructure": "Cluster",
    "application": "app",
    "domain": "core",
    "errors": "error",
    "persistence": "database"
  },
  "makefile.configureOnOpen": true,
  // "typescript.inlayHints.parameterNames.enabled": "all",
  // "typescript.inlayHints.variableTypes.enabled": true,
  // "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  // "typescript.inlayHints.parameterTypes.enabled": true,
  // "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  // "typescript.tsserver.log": "verbose",
  "typescript.tsserver.watchOptions": {
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriorityPolling",
    "watchFile": "useFsEventsOnParentDirectory",
    "synchronousWatchDirectory": true,
    "excludeDirectories": ["./node_modules/**/*"]
  },
  "redhat.telemetry.enabled": true,
  "svelte.enable-ts-plugin": true,
  "todo-tree.general.tags": [
    "BUG:",
    "HACK:",
    "FIXME:",
    "TODO:",
    "NOTE:",
    "DOC:",
    "DEBT:",
    "TRANSLATE:",
    "TIP:",
    "REVIEW:"
  ],
  "todo-tree.highlights.customHighlight": {
    "TODO:": {
      "icon": "issue-opened",
      "gutterIcon": true,
      "iconColour": "#FFD580"
    },
    "BUG:": {
      "icon": "bug",
      "gutterIcon": true,
      "iconColour": "#FF6B6B"
    },
    "HACK:": {
      "icon": "tools",
      "gutterIcon": true,
      "iconColour": "#A3A3A3"
    },
    "FIXME:": {
      "icon": "flame",
      "gutterIcon": true,
      "iconColour": "#FF926B"
    },
    "NOTE:": {
      "icon": "note",
      "gutterIcon": true,
      "iconColour": "#6BC1FF"
    },
    "DOC:": {
      "icon": "book",
      "gutterIcon": true,
      "iconColour": "#86D2B5"
    },
    "DEBT:": {
      "icon": "issue-reopened",
      "gutterIcon": true,
      "iconColour": "#F06C9B"
    },
    "TRANSLATE:": {
      "icon": "globe",
      "gutterIcon": true,
      "iconColour": "#A29BFE"
    },
    "TIP:": {
      "icon": "light-bulb",
      "gutterIcon": true,
      "iconColour": "#FFCC00" // Un amarillo brillante para representar ideas o consejos útiles.
    },
    "REVIEW:": {
      "icon": "eye",
      "gutterIcon": true,
      "iconColour": "#8A2BE2" // A violet color to represent the review process.
    }
  },
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|\\s\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
  "remote.defaultExtensionsIfInstalledLocally": [
    "GitHub.copilot",
    "GitHub.copilot-chat",
    "GitHub.vscode-pull-request-github"
  ],
}
